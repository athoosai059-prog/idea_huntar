# Claude AI (required)
ANTHROPIC_API_KEY=sk-ant-your-key-here
CLAUDE_MODEL=claude-sonnet-4-6

# Reddit - get from reddit.com/prefs/apps → "create app" → choose "script"
REDDIT_CLIENT_ID=your_client_id
REDDIT_CLIENT_SECRET=your_client_secret
REDDIT_USER_AGENT=IdeaHunter:v1.0 (by u/yourusername)

# Product Hunt - get from producthunt.com/v2/oauth/applications
PRODUCTHUNT_TOKEN=your_ph_token

# SerpAPI - optional, free tier = 100 searches/month (serpapi.com)
SERPAPI_KEY=

# Pipeline settings
SCRAPE_SCHEDULE=0 6 * * *
MIN_IDEA_SCORE=6.0
BATCH_SIZE=100

# AI Provider Keys (Optional but recommended for resilience)
# Groq: https://console.groq.com/
GROQ_API_KEY=gsk_...
# Together AI: https://api.together.xyz/
TOGETHER_API_KEY=...
# Cerebras: https://cloud.cerebras.ai/
CEREBRAS_API_KEY=...

# Primary Provider (groq, together, cerebras, gemini, anthropic)
PRIMARY_AI=groq
